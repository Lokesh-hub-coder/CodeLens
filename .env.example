# Copy to backend/.env for local backend runs, or to .env for Docker Compose.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Leave QDRANT_URL empty to use local embedded Qdrant storage.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
INDEX_STORAGE_DIR=./data/index

JAVA_BIN=java
PARSER_CLASSPATH=
PARSER_TIMEOUT_SECONDS=120
PARSER_MAX_HEAP_MB=512
PARSER_ACTIVE_PROCESSOR_COUNT=2
EXCLUDE_TEST_SOURCES=true

EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

TOP_K_CANDIDATES=50
GRAPH_MAX_HOPS=4
DEFAULT_TOKEN_BUDGET=8000
RANKER_STRATEGY=greedy
ACOR_USE_INTENT_WEIGHTS=false
ACOR_WEIGHT_SEMANTIC=0.40
ACOR_WEIGHT_CALL_GRAPH=0.20
ACOR_WEIGHT_DEPENDENCY=0.15
ACOR_WEIGHT_SYMBOL=0.25
LIVE_SYNC_DEBOUNCE_SECONDS=0.4
