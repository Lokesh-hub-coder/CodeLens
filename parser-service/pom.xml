<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.codelensai</groupId>
  <artifactId>parser-service</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <!--
    This module is intentionally a plain CLI, not a Spring Boot service:
    it is invoked once per indexing request as a subprocess by
    backend/app/parsing/java_bridge.py, not run as a long-lived server.
    See that file's module docstring for the reasoning and the natural
    upgrade path if the team later wants persistent/incremental parsing.
  -->

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javaparser.version>3.26.2</javaparser.version>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <!-- Core AST parsing + the symbol solver, which is what lets us resolve
         a method call expression back to the fully-qualified declaring
         class (required for accurate cross-file call-graph edges). -->
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>${javaparser.version}</version>
    </dependency>

    <!-- JSON output consumed by app/parsing/java_bridge.py -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>parser-service-${project.version}</finalName>
    <plugins>
      <!-- Builds a single self-contained JAR (JavaParser + Jackson bundled
           in) so `java -jar parser-service-1.0.0.jar <repo> <out.json>`
           works with no extra -cp wrangling on the Python side. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.codelensai.parser.ParserApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>